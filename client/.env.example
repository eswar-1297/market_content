# Microsoft Login (Entra ID / Azure AD)
# Get these from your DevOps team after creating the SPA app registration
VITE_MSAL_CLIENT_ID=your-auth-app-client-id
VITE_MSAL_TENANT_ID=your-azure-ad-tenant-id

# Hotjar Site ID, digits only. Optional -- public/runtime-config.js already sets it, and that value
# wins. Set this only to bake a default into a locally built bundle. Blank disables Hotjar.
VITE_HOTJAR_SITE_ID=
